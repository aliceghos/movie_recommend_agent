# --- 数据库（必填）---
# 本机用 brew 起：brew install postgresql@17 pgvector && brew services start postgresql@17
#              createdb movie_agent && psql -d movie_agent -c 'CREATE EXTENSION vector;'
# 驱动固定 psycopg3，连接串写 postgresql:// 即可，服务内部会补 +psycopg
DATABASE_URL=postgresql://localhost:5432/movie_agent
# DB_POOL_MIN_SIZE=2
# DB_POOL_MAX_SIZE=10

# --- 认证（必填）---
# 生成：openssl rand -hex 32
# 少于 32 字符或明显是占位符时服务会拒绝启动 —— 弱密钥比没有认证更危险，
# 因为任何人都能自己签一个 token 冒充任意用户
JWT_SECRET=generate_with_openssl_rand_hex_32
# JWT_ACCESS_TTL_MINUTES=15
# JWT_REFRESH_TTL_DAYS=14

# LLM：任意 OpenAI 兼容接口（下例为 DeepSeek 开放平台）
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-flash

# TMDB 电影数据接口
TMDB_API_KEY=your_tmdb_key_here
# 可选：api.themoviedb.org 不可达时改用等价域名
# TMDB_BASE_URL=https://api.tmdb.org/3

# HuggingFace 镜像（可选）：RAG 的本地嵌入模型首次运行需下载权重，
# 若无法直连 huggingface.co 可打开此行
# HF_ENDPOINT=https://hf-mirror.com

# MCP（均有默认值，不填也能跑）
# 自建 TMDB Server 的地址，连不上时 Agent 自动回落到进程内的本地工具
# MCP_TMDB_URL=http://127.0.0.1:8931/mcp
# TMDB Server 自身的监听地址
# MCP_TMDB_HOST=127.0.0.1
# MCP_TMDB_PORT=8931
# 第三方 filesystem MCP Server 的沙箱根目录（观影清单）
# 每个用户在此目录下有独立子目录，由服务端强制隔离，模型无法跨用户读写
# MCP_WATCHLIST_DIR=./data/watchlist

# Streamlit 客户端要访问的 API 地址
# API_BASE_URL=http://127.0.0.1:8000

PYTHONPATH=.
