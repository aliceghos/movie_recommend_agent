# LLM：任意 OpenAI 兼容接口（下例为 DeepSeek 开放平台）
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-flash

# TMDB 电影数据接口
TMDB_API_KEY=your_tmdb_key_here
# 可选：api.themoviedb.org 不可达时改用等价域名
# TMDB_BASE_URL=https://api.tmdb.org/3

# HuggingFace 镜像（可选）：RAG 的本地嵌入模型首次运行需下载权重，
# 若无法直连 huggingface.co 可打开此行
# HF_ENDPOINT=https://hf-mirror.com

# MCP（均有默认值，不填也能跑）
# 自建 TMDB Server 的地址，连不上时 Agent 自动回落到进程内的本地工具
# MCP_TMDB_URL=http://127.0.0.1:8931/mcp
# TMDB Server 自身的监听地址
# MCP_TMDB_HOST=127.0.0.1
# MCP_TMDB_PORT=8931
# 第三方 filesystem MCP Server 的沙箱目录（观影清单）
# MCP_WATCHLIST_DIR=./data/watchlist

# 长期记忆的用户标识，决定 Store 里的命名空间
# MOVIE_AGENT_USER_ID=default

PYTHONPATH=.
